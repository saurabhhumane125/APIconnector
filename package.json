{
  "name": "universal-ai-api-hub",
  "version": "1.0.0",
  "description": "Universal AI API Connector & API Hub - Production-grade Multi-Provider AI Platform",
  "main": "app/backend/index.ts",
  "scripts": {
    "dev:backend": "tsx watch app/backend/index.ts",
    "dev:frontend": "vite --config app/frontend/vite.config.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "vite build --config app/frontend/vite.config.ts",
    "build:backend": "tsc -p tsconfig.server.json",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "tsx app/backend/index.ts",
    "db:migrate": "tsx database/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "api-hub",
    "connectors",
    "openai",
    "groq",
    "gemini",
    "anthropic",
    "developer-platform"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
