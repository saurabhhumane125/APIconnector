# Universal AI API Hub - Environment Configuration

# Server configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database configuration
DATABASE_PATH=data/hub.db

# Master Admin Key for administrative operations (Optional, defaults to open dev mode)
ADMIN_SECRET_KEY=admin_secret_hub_key_change_in_production

# AI Provider API Keys (Stored server-side ONLY, never exposed to clients)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Request rate limits & limits
MAX_REQUEST_BODY_SIZE_MB=15
DEFAULT_EXECUTION_TIMEOUT_MS=30000
